{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "scripts": {
    "dev": "pnpm --filter \"@workspace/*\" --parallel dev",
    "dev:dashboard": "pnpm --filter @workspace/hexpertify-dashboard dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "build": "pnpm run typecheck && pnpm --filter @workspace/hexpertify-dashboard build && pnpm --filter @workspace/api-server build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.6.0",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "lightningcss": "^1.33.0",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
